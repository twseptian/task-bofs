        }
      ],
      "arguments": [],
      "entrypoint": "go"
    },
    {
      "command_name": "priv-svcmod",
      "help": "Checks services whose config or binary is modifiable by the current user",
      "files": [
        {
          "os": "windows",
          "arch": "amd64",
          "path": "/ModifiableSVCCheck.x64.o"
        }
      ],
      "arguments": [],
      "entrypoint": "go"
    },
    {
