{
  "name": "privkit",
  "version": "1.0.0",
  "extension_author": "twseptian",
  "original_author": "PrivKit upstream authors / nukeratframework armory",
  "repo_url": "https://github.com/nukeratframework/armory",
  "commands": [
    {
      "command_name": "priv-alwaysinstall",
      "help": "Checks AlwaysInstallElevated policy (HKCU+HKLM set to 1) - MSI install-elevation opportunity",
      "files": [
        {
          "os": "windows",
          "arch": "amd64",
          "path": "/AlwaysInstallElevatedCheck.x64.o"
        }
      ],
      "arguments": [],
      "entrypoint": "go"
    },
    {
      "command_name": "priv-autologon",
      "help": "Checks registry for stored autologon credentials (DefaultUserName/DefaultPassword)",
      "files": [
        {
          "os": "windows",
          "arch": "amd64",
          "path": "/AutoLogonCheck.x64.o"
        }
      ],
      "arguments": [],
      "entrypoint": "go"
    },
    {
      "command_name": "priv-credman",
      "help": "Enumerates stored Windows Credential Manager entries",
      "files": [
        {
          "os": "windows",
          "arch": "amd64",
          "path": "/CredentialManagerCheck.x64.o"
        }
      ],
      "arguments": [],
      "entrypoint": "go"
    },
    {
      "command_name": "priv-hijackable",
      "help": "Checks PATH entries writable by the current user (PATH hijack opportunity)",
